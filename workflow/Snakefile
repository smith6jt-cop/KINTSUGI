"""
KINTSUGI Snakemake Pipeline
============================

Declarative workflow for multiplex immunofluorescence image processing.
Replaces the custom submit.sh orchestration with Snakemake's native
dependency management, skip-existing, and failure recovery.

Processing stages:
  1. stitch              - Illumination correction (BaSiC) + tile stitching
  2. deconvolve          - Richardson-Lucy deconvolution
  3. edf                 - Extended depth of focus (variance-based z-projection)
  4. registration        - Multi-cycle alignment via VALIS (all cycles at once)
  5. signal_isolation    - Autofluorescence subtraction (batch, all channels)

Stages 1-3 process one cycle each (all channels, all z-planes).
Stages 4-5 process ALL cycles at once (aggregate rules).
Snakemake's DAG ensures: stitch -> deconvolve -> edf (per-cycle) -> registration -> signal_isolation.

Multi-account scheduling:
  Cycles are pre-assigned to accounts and modes (GPU/CPU) at DAG creation.
  GPU slots come from each account's QOS gres/gpu allocation.
  CPU slots use 85% of each account's CPU allocation (separate pool).
  Lambda resource functions route each cycle to the correct account/partition.
  Registration gets a static account assignment (first GPU account preferred).

Usage:
  snakemake --profile profiles/slurm -j 24  # Multi-account
  snakemake --cores 4                        # Local
  snakemake -n                               # Dry run
"""

import os
import re
from pathlib import Path

configfile: "config.yaml"

# ---------------------------------------------------------------------------
# Configuration (all from config.yaml — single source of truth)
# ---------------------------------------------------------------------------
PROJECT = config["project_dir"]
KINTSUGI = config["kintsugi_dir"]
CYCLES = config["cycles"]
CHANNELS = config["channels"]
N_ZPLANES = config["n_zplanes"]

# Channel names for marker-named EDF output
CHANNEL_NAMES = config.get("channel_names", {})

# Resource configuration
RES = config.get("resources", {})
CPU_TIME_MULT = int(RES.get("cpu_time_multiplier", 5))
CPU_CPUS = int(RES.get("cpu_cpus_per_task", 8))

# Format cycle numbers as zero-padded strings for file paths
def cyc_fmt(cycle):
    """Format cycle number with zero-padding.

    Accepts int or str (Snakemake CLI --config passes strings).
    """
    return f"{int(cycle):02d}"


# ---------------------------------------------------------------------------
# EDF filename helper (marker names from CHANNELNAMES.txt)
# ---------------------------------------------------------------------------
def get_edf_filename(cycle, channel):
    """Marker name if available, else CH#_edf.tif fallback."""
    cyc_key = int(cycle)
    ch_idx = int(channel) - 1
    # Try int key first (YAML default), then string key
    names = CHANNEL_NAMES.get(cyc_key, CHANNEL_NAMES.get(str(cyc_key), []))
    if names and ch_idx < len(names):
        return names[ch_idx].replace("/", "_").replace(" ", "_") + ".tif"
    return f"CH{channel}_edf.tif"


# ---------------------------------------------------------------------------
# Cycle directory resolution
# ---------------------------------------------------------------------------
# Raw cycle directories may use different naming conventions:
#   cyc01, cyc001, cyc001_reg001_200210_170925, Cyc01, etc.
# This function resolves the actual directory name at DAG creation time,
# mirroring the find_cycle_dir() logic in the wrapper scripts.
def _resolve_raw_cycle_dir(cycle_num):
    """Resolve actual cycle directory path from cycle number."""
    cycle_num = int(cycle_num)  # CLI --config passes strings
    raw_dir = Path(PROJECT) / "data" / "raw"

    # Try glob patterns for long-form names (e.g., cyc001_reg001_200210_170925)
    for pattern in [
        f"cyc{cycle_num:03d}_*",
        f"cyc{cycle_num:02d}_*",
        f"Cyc{cycle_num:02d}_*",
    ]:
        matches = sorted(raw_dir.glob(pattern))
        if matches:
            return str(matches[0])

    # Try exact short-form names
    for name in [
        f"cyc{cycle_num:03d}",
        f"cyc{cycle_num:02d}",
        f"Cyc{cycle_num:02d}",
    ]:
        candidate = raw_dir / name
        if candidate.exists():
            return str(candidate)

    # Fallback: return the 2-digit form (Snakemake will error if missing)
    return str(raw_dir / f"cyc{cycle_num:02d}")


# Build a lookup table so the stitch rule can reference resolved paths
_RAW_CYCLE_DIRS = {cyc_fmt(c): _resolve_raw_cycle_dir(c) for c in CYCLES}


def get_raw_dir(wildcards):
    """Input function: return the resolved raw directory for a cycle."""
    return _RAW_CYCLE_DIRS[wildcards.cycle]


# ---------------------------------------------------------------------------
# Multi-account cycle assignment
# ---------------------------------------------------------------------------
ACCOUNTS = RES.get("accounts", [])


def _build_cycle_assignment():
    """Pre-assign each cycle to an account and mode (gpu-only).

    All cycles are assigned to GPU, round-robin across accounts proportional
    to each account's GPU slot count.  Overflow cycles queue in SLURM until
    a GPU slot frees up — this is dramatically faster than CPU fallback.

    Measured per-step timings (CX_19-003, 9x7 grid, 4ch, 20z):
      Stitch: GPU ~8 min  vs CPU ~200 min  (25x speedup)
      Decon:  GPU ~12 min vs CPU ~60 min   (5x speedup)
      EDF:    GPU ~1.5 min vs CPU ~22 min  (15x speedup)
      Total:  GPU ~22 min vs CPU ~282 min per cycle (~13x)

    With 9 cycles and 5 GPU slots, GPU-only finishes in ~44 min (2 waves).
    CPU overflow would add ~282 min per cycle.  Queuing for GPU always wins.

    Snakemake's -j flag (set to total GPU slots) limits concurrent SLURM
    submissions, so cycles naturally pipeline through freed GPU slots.
    """
    assignment = {}

    # Build GPU-only queue: each account contributes gpu_slots entries,
    # then round-robin for any overflow beyond the total GPU slot count.
    gpu_queue = []
    for acct in ACCOUNTS:
        gpu_queue.extend([{
            "account": acct["name"],
            "mode": "gpu",
            "partition": acct.get("partition_gpu", "hpg-b200,hpg-turin"),
        }] * acct.get("gpu_slots", 0))

    # Build list of GPU accounts for round-robin overflow
    gpu_accounts = [acct for acct in ACCOUNTS if acct.get("gpu_slots", 0) > 0]

    for i, cyc in enumerate(CYCLES):
        cyc_key = cyc_fmt(cyc)
        if i < len(gpu_queue):
            assignment[cyc_key] = gpu_queue[i]
        else:
            # Overflow: round-robin across GPU accounts (still GPU mode)
            acct = gpu_accounts[i % len(gpu_accounts)] if gpu_accounts else ACCOUNTS[0]
            assignment[cyc_key] = {
                "account": acct["name"],
                "mode": "gpu",
                "partition": acct.get("partition_gpu", "hpg-b200,hpg-turin"),
            }

    return assignment


_CYCLE_ASSIGN = _build_cycle_assignment() if ACCOUNTS else {}

# Fallback for single-account / legacy config (no accounts list)
if not _CYCLE_ASSIGN:
    _default_acct = RES.get("account_gpu", RES.get("account", ""))
    _default_part = RES.get("partition_gpu", "hpg-b200")
    if not _default_acct:
        raise ValueError(
            "No SLURM accounts configured in config.yaml.\n"
            "Run 'kintsugi workflow config .' to auto-detect accounts."
        )
    for cyc in CYCLES:
        _CYCLE_ASSIGN[cyc_fmt(cyc)] = {
            "account": _default_acct,
            "mode": "gpu",
            "partition": _default_part,
        }


def _assign(wc):
    """Get assignment dict for a cycle wildcard."""
    return _CYCLE_ASSIGN[wc.cycle]


def _is_gpu(wc):
    return _assign(wc)["mode"] == "gpu"


# ---------------------------------------------------------------------------
# Target rule: request all EDF sentinels (one per cycle)
# ---------------------------------------------------------------------------
# EDF rules produce sentinel-only outputs because marker filenames vary per
# cycle. The edf.py script writes the actual marker-named TIFs (e.g., CD45.tif).
# After completion, use 'validate' rule to verify all expected files exist.

def all_edf_sentinels():
    """Build list of EDF sentinel targets (one per cycle)."""
    return expand(
        "{project}/data/processed/edf/cyc{cycle}/.snakemake_complete",
        project=PROJECT,
        cycle=[cyc_fmt(c) for c in CYCLES],
    )


def all_edf_marker_files():
    """Build list of expected marker-named EDF files (for validation)."""
    targets = []
    for c in CYCLES:
        for ch in CHANNELS:
            fname = get_edf_filename(c, ch)
            targets.append(f"{PROJECT}/data/processed/edf/cyc{cyc_fmt(c)}/{fname}")
    return targets


def all_qc_sentinels():
    """Build list of QC report sentinel targets (one per stage)."""
    return [
        f"{PROJECT}/qc_plots/.snakemake_complete_stitch",
        f"{PROJECT}/qc_plots/.snakemake_complete_decon",
        f"{PROJECT}/qc_plots/.snakemake_complete_edf",
        f"{PROJECT}/qc_plots/.snakemake_complete_registration",
        f"{PROJECT}/qc_plots/.snakemake_complete_signal_isolation",
    ]


rule all:
    input:
        f"{PROJECT}/data/processed/signal_isolated/.snakemake_complete",
        *all_qc_sentinels(),


rule qc:
    """Standalone target: generate only QC reports (no reprocessing)."""
    input: all_qc_sentinels()


rule validate:
    """Check that all expected marker-named EDF files exist after processing."""
    input: all_edf_sentinels()
    run:
        import sys
        missing = [f for f in all_edf_marker_files() if not os.path.exists(f)]
        if missing:
            print(f"ERROR: {len(missing)} expected EDF files missing:")
            for f in missing[:20]:
                print(f"  {f}")
            sys.exit(1)
        print(f"OK: All {len(all_edf_marker_files())} marker-named EDF files verified")


# ===========================================================================
# Rule 1: Stitching (includes BaSiC illumination correction)
# ===========================================================================
# One job per cycle. Produces all channels x all z-planes as TIFF files.
# The sentinel file signals completion (avoids declaring hundreds of outputs).

rule stitch:
    input:
        raw_dir=get_raw_dir,
    output:
        sentinel="{project}/data/processed/stitched/cyc{cycle}/.snakemake_complete",
    params:
        project_dir=PROJECT,
        kintsugi_dir=KINTSUGI,
        channels=CHANNELS,
        device_mode=lambda wc: _assign(wc)["mode"],

    resources:
        mem_mb=lambda wc: RES.get("mem_stitch", 4000) if _is_gpu(wc) else RES.get("cpu_mem_stitch", 48000),
        runtime=lambda wc: RES.get("time_stitch", 240) * (1 if _is_gpu(wc) else CPU_TIME_MULT),
        slurm_partition=lambda wc: _assign(wc)["partition"],
        slurm_account=lambda wc: _assign(wc)["account"],
        gres=lambda wc: "gpu:1" if _is_gpu(wc) else "",
        cpus_per_task=lambda wc: 4 if _is_gpu(wc) else CPU_CPUS,
    log:
        "{project}/slurm/logs/snakemake/stitch_cyc{cycle}.log",
    script:
        "scripts/stitch.py"


# ===========================================================================
# Rule 2: Deconvolution
# ===========================================================================
# One job per cycle. Depends on stitching completion sentinel.

rule deconvolve:
    input:
        stitch_done="{project}/data/processed/stitched/cyc{cycle}/.snakemake_complete",
    output:
        sentinel="{project}/data/processed/deconvolved/cyc{cycle}/.snakemake_complete",
    params:
        project_dir=PROJECT,
        kintsugi_dir=KINTSUGI,
        channels=CHANNELS,
        device_mode=lambda wc: _assign(wc)["mode"],

    resources:
        mem_mb=lambda wc: RES.get("mem_decon", 4000) if _is_gpu(wc) else RES.get("cpu_mem_decon", 128000),
        runtime=lambda wc: RES.get("time_decon", 240) * (1 if _is_gpu(wc) else CPU_TIME_MULT),
        slurm_partition=lambda wc: _assign(wc)["partition"],
        slurm_account=lambda wc: _assign(wc)["account"],
        gres=lambda wc: "gpu:1" if _is_gpu(wc) else "",
        cpus_per_task=lambda wc: 4 if _is_gpu(wc) else CPU_CPUS,
    log:
        "{project}/slurm/logs/snakemake/decon_cyc{cycle}.log",
    script:
        "scripts/deconvolve.py"


# ===========================================================================
# Rule 3: Extended Depth of Focus
# ===========================================================================
# One job per cycle. Uses sentinel-only output since marker filenames vary
# per cycle. The rule all targets verify the actual EDF files exist.

rule edf:
    input:
        decon_done="{project}/data/processed/deconvolved/cyc{cycle}/.snakemake_complete",
    output:
        sentinel="{project}/data/processed/edf/cyc{cycle}/.snakemake_complete",
    params:
        project_dir=PROJECT,
        kintsugi_dir=KINTSUGI,
        channels=CHANNELS,
        device_mode=lambda wc: _assign(wc)["mode"],
        channel_names=CHANNEL_NAMES,

    resources:
        mem_mb=lambda wc: RES.get("mem_edf", 4000) if _is_gpu(wc) else RES.get("cpu_mem_edf", 96000),
        runtime=lambda wc: RES.get("time_edf", 60) * (1 if _is_gpu(wc) else CPU_TIME_MULT),
        slurm_partition=lambda wc: _assign(wc)["partition"],
        slurm_account=lambda wc: _assign(wc)["account"],
        gres=lambda wc: "gpu:1" if _is_gpu(wc) else "",
        cpus_per_task=lambda wc: 4 if _is_gpu(wc) else CPU_CPUS,
    log:
        "{project}/slurm/logs/snakemake/edf_cyc{cycle}.log",
    script:
        "scripts/edf.py"


# ===========================================================================
# Rule 4: Registration (multi-cycle alignment via VALIS)
# ===========================================================================
# Single job processing ALL cycles at once. Requires all EDF outputs.
# No {cycle} wildcard — static account assignment.

# Registration configuration
REG_CFG = config.get("registration", {})

def _registration_assignment():
    """Pick account for registration: prefer first GPU account, CPU fallback.

    Registration uses VggFD feature detector (GPU-accelerated) by default.
    Returns a dict with account, mode, and partition.
    """
    # Prefer GPU account for VggFD feature detector
    for acct in ACCOUNTS:
        if acct.get("gpu_slots", 0) > 0:
            return {
                "account": acct["name"],
                "mode": "gpu",
                "partition": acct.get("partition_gpu", "hpg-b200,hpg-turin"),
            }
    # CPU fallback (will use OrbFD instead of VggFD)
    if ACCOUNTS:
        return {
            "account": ACCOUNTS[0]["name"],
            "mode": "cpu",
            "partition": ACCOUNTS[0].get("partition_cpu", "hpg-default"),
        }
    # No accounts configured — local execution
    return {"account": "", "mode": "cpu", "partition": ""}


_REG_ASSIGN = _registration_assignment()


rule registration:
    input:
        edf_done=all_edf_sentinels(),
    output:
        sentinel="{project}/data/processed/registered/.snakemake_complete",
    params:
        project_dir=PROJECT,
        kintsugi_dir=KINTSUGI,
        channels=CHANNELS,
        cycles=CYCLES,
        channel_names=CHANNEL_NAMES,
        device_mode=_REG_ASSIGN["mode"],
    resources:
        mem_mb=RES.get("mem_registration", 64000) if _REG_ASSIGN["mode"] == "gpu" else RES.get("cpu_mem_registration", 64000),
        runtime=RES.get("time_registration", 120) if _REG_ASSIGN["mode"] == "gpu" else RES.get("time_registration", 120) * CPU_TIME_MULT,
        slurm_partition=_REG_ASSIGN["partition"],
        slurm_account=_REG_ASSIGN["account"],
        gres="gpu:1" if _REG_ASSIGN["mode"] == "gpu" else "",
        cpus_per_task=4 if _REG_ASSIGN["mode"] == "gpu" else CPU_CPUS,
    log:
        "{project}/slurm/logs/snakemake/registration.log",
    script:
        "scripts/registration.py"


# ===========================================================================
# Rule 5: Signal Isolation (autofluorescence subtraction)
# ===========================================================================
# Single aggregate job processing ALL registered channels at once.
# CPU-only — uses numpy/scipy, no GPU needed. Reuses QC CPU partition routing.
# Supports recipe-driven (legacy param files) or auto-analyzed subtraction.

SI_CFG = config.get("signal_isolation", {})

rule signal_isolation:
    input:
        reg_done=f"{PROJECT}/data/processed/registered/.snakemake_complete",
    output:
        sentinel=f"{PROJECT}/data/processed/signal_isolated/.snakemake_complete",
    params:
        project_dir=PROJECT,
        kintsugi_dir=KINTSUGI,
        channels=CHANNELS,
        cycles=CYCLES,
        channel_names=CHANNEL_NAMES,
    resources:
        mem_mb=RES.get("mem_signal_isolation", 32000),
        runtime=RES.get("time_signal_isolation", 120),
        slurm_partition=_QC_CPU_ASSIGN["partition"],
        slurm_account=_QC_CPU_ASSIGN["account"],
        gres="",
        cpus_per_task=RES.get("cpus_signal_isolation", 4),
    log:
        f"{PROJECT}/slurm/logs/snakemake/signal_isolation.log",
    script:
        "scripts/signal_isolation.py"


rule qc_signal_isolation:
    input:
        si_done=f"{PROJECT}/data/processed/signal_isolated/.snakemake_complete",
    output:
        sentinel=f"{PROJECT}/qc_plots/.snakemake_complete_signal_isolation",
    params:
        stage="signal_isolation",
        project_dir=PROJECT,
        kintsugi_dir=KINTSUGI,
        cycles=CYCLES,
        channels=CHANNELS,
        n_zplanes=N_ZPLANES,
        channel_names=CHANNEL_NAMES,
    resources:
        mem_mb=RES.get("mem_qc", 64000),
        runtime=RES.get("time_qc_signal_isolation", 60),
        slurm_partition=_QC_CPU_ASSIGN["partition"],
        slurm_account=_QC_CPU_ASSIGN["account"],
        gres="",
        cpus_per_task=2,
    log:
        f"{PROJECT}/slurm/logs/snakemake/qc_signal_isolation.log",
    script:
        "scripts/qc_report.py"


# ===========================================================================
# Rule 7: Spillover Correction (REDSEA) — optional post-segmentation
# ===========================================================================
# CPU-only job. Requires a multichannel image and cell segmentation mask.
# Produces corrected/uncorrected per-cell quantification CSVs.
# This rule is NOT part of the default 'all' target — invoke explicitly:
#   snakemake spillover_correction --profile profiles/slurm
#
# Reference: Bai et al., Front. Immunol. 12:652631 (2021)

REDSEA_CFG = config.get("redsea", {})

rule spillover_correction:
    input:
        image=f"{PROJECT}/data/processed/signal_isolated/{{sample}}.ome.tif",
        mask=f"{PROJECT}/data/processed/segmented/{{sample}}_cellMask.tif",
        markers=f"{PROJECT}/meta/markers.csv",
    output:
        corrected=f"{PROJECT}/data/processed/spillover_corrected/{{sample}}_corrected.csv",
        uncorrected=f"{PROJECT}/data/processed/spillover_corrected/{{sample}}_uncorrected.csv",
        sentinel=f"{PROJECT}/data/processed/spillover_corrected/.{{sample}}_spillover.complete",
    params:
        project_dir=PROJECT,
        kintsugi_dir=KINTSUGI,
    resources:
        mem_mb=65536,
        runtime=120,
        slurm_partition=_REG_ASSIGN["partition"],
        slurm_account=_REG_ASSIGN["account"],
        gres="",
        cpus_per_task=8,
    log:
        f"{PROJECT}/slurm/logs/snakemake/spillover_{{sample}}.log",
    script:
        "scripts/spillover_correction.py"


# ===========================================================================
# Rule 8: 3D Vessel Segmentation (Frangi + skeleton)
# ===========================================================================
# Standalone — NOT in default 'all' target. Invoke explicitly:
#   snakemake vessel3d --profile profiles/slurm --config vessel_cycle=3 vessel_channel=2
# Requires deconvolved z-stack (full 3D, before EDF collapses z).
#
# Runs on CPU (hpg-turin / L4 nodes have 771 GB RAM). Frangi Hessian needs
# ~72 GB float32 for isotropic 9x7 volumes — exceeds L4's 24 GB VRAM.
# No GPU slot requested, so it doesn't block GPU scheduling for other jobs.

VESSEL_CFG = config.get("vessel3d", {})


def _vessel3d_assignment():
    """Pick account + partition for vessel3d: CPU-only on Turin (L4 nodes).

    Vessel3d Frangi filter on isotropic volumes (40x7487x10061) needs ~72 GB
    for 6 Hessian arrays in float32 — exceeds L4's 24 GB VRAM.  Turin nodes
    have 771 GB RAM, so CPU mode works well without blocking a GPU slot.
    """
    # Use vessel3d-specific partition if configured, else default to hpg-turin
    v3d_partition = VESSEL_CFG.get("partition", "hpg-turin")
    for acct in ACCOUNTS:
        if acct.get("gpu_slots", 0) > 0:
            return {"account": acct["name"], "partition": v3d_partition, "mode": "cpu"}
    # Fallback
    return {"account": _REG_ASSIGN["account"], "partition": v3d_partition, "mode": "cpu"}


_V3D_ASSIGN = _vessel3d_assignment()

rule vessel3d:
    input:
        decon_done=f"{PROJECT}/data/processed/deconvolved/cyc{{cycle}}/.snakemake_complete",
    output:
        sentinel=f"{PROJECT}/data/processed/vessel_3d/cyc{{cycle}}/.snakemake_complete",
    params:
        project_dir=PROJECT,
        kintsugi_dir=KINTSUGI,
        channel=VESSEL_CFG.get("channel", 2),
        marker=VESSEL_CFG.get("marker", "CD31"),
        device=VESSEL_CFG.get("device", "cpu"),
    resources:
        mem_mb=RES.get("mem_vessel3d", 256000),
        runtime=RES.get("time_vessel3d", 240),
        slurm_partition=_V3D_ASSIGN["partition"],
        slurm_account=_V3D_ASSIGN["account"],
        gres="",
        cpus_per_task=int(VESSEL_CFG.get("cpus", 8)),
    log:
        f"{PROJECT}/slurm/logs/snakemake/vessel3d_cyc{{cycle}}.log",
    script:
        "scripts/vessel3d.py"


# ===========================================================================
# QC Report Rules (aggregate — one per stage, all cycles)
# ===========================================================================
# Each QC rule runs AFTER all cycles for its stage complete.
# Produces summary heatmaps, z-plane profiles, and cross-stage comparison PDFs.
# Uses Kprocess QC functions: run_stitched_qc(), run_decon_qc(), run_edf_qc().

def _all_stitch_sentinels():
    return expand(
        "{project}/data/processed/stitched/cyc{cycle}/.snakemake_complete",
        project=PROJECT,
        cycle=[cyc_fmt(c) for c in CYCLES],
    )


def _all_decon_sentinels():
    return expand(
        "{project}/data/processed/deconvolved/cyc{cycle}/.snakemake_complete",
        project=PROJECT,
        cycle=[cyc_fmt(c) for c in CYCLES],
    )


def _qc_cpu_assignment():
    """Pick CPU partition for QC rules (no GPU needed).

    QC rules (stitch, decon, edf, registration) use pyvips + matplotlib,
    not GPU compute. Running them on CPU frees GPU slots for processing.
    """
    for acct in ACCOUNTS:
        if acct.get("partition_cpu"):
            return {"account": acct["name"], "partition": acct["partition_cpu"]}
    # Fallback to registration assignment account with hpg-default
    return {"account": _REG_ASSIGN["account"], "partition": "hpg-default"}


_QC_CPU_ASSIGN = _qc_cpu_assignment()


rule qc_stitch:
    input:
        stitch_done=_all_stitch_sentinels(),
    output:
        sentinel=f"{PROJECT}/qc_plots/.snakemake_complete_stitch",
    params:
        stage="stitch",
        project_dir=PROJECT,
        kintsugi_dir=KINTSUGI,
        cycles=CYCLES,
        channels=CHANNELS,
        n_zplanes=N_ZPLANES,
        channel_names=CHANNEL_NAMES,
    resources:
        mem_mb=RES.get("mem_qc", 64000),
        runtime=RES.get("time_qc", 120),
        slurm_partition=_QC_CPU_ASSIGN["partition"],
        slurm_account=_QC_CPU_ASSIGN["account"],
        gres="",
        cpus_per_task=4,
    log:
        f"{PROJECT}/slurm/logs/snakemake/qc_stitch.log",
    script:
        "scripts/qc_report.py"


rule qc_decon:
    input:
        decon_done=_all_decon_sentinels(),
    output:
        sentinel=f"{PROJECT}/qc_plots/.snakemake_complete_decon",
    params:
        stage="decon",
        project_dir=PROJECT,
        kintsugi_dir=KINTSUGI,
        cycles=CYCLES,
        channels=CHANNELS,
        n_zplanes=N_ZPLANES,
        channel_names=CHANNEL_NAMES,
    resources:
        mem_mb=RES.get("mem_qc", 64000),
        runtime=RES.get("time_qc", 120),
        slurm_partition=_QC_CPU_ASSIGN["partition"],
        slurm_account=_QC_CPU_ASSIGN["account"],
        gres="",
        cpus_per_task=4,
    log:
        f"{PROJECT}/slurm/logs/snakemake/qc_decon.log",
    script:
        "scripts/qc_report.py"


rule qc_edf:
    input:
        edf_done=all_edf_sentinels(),
    output:
        sentinel=f"{PROJECT}/qc_plots/.snakemake_complete_edf",
    params:
        stage="edf",
        project_dir=PROJECT,
        kintsugi_dir=KINTSUGI,
        cycles=CYCLES,
        channels=CHANNELS,
        n_zplanes=N_ZPLANES,
        channel_names=CHANNEL_NAMES,
    resources:
        mem_mb=RES.get("mem_qc", 64000),
        runtime=RES.get("time_qc", 120),
        slurm_partition=_QC_CPU_ASSIGN["partition"],
        slurm_account=_QC_CPU_ASSIGN["account"],
        gres="",
        cpus_per_task=4,
    log:
        f"{PROJECT}/slurm/logs/snakemake/qc_edf.log",
    script:
        "scripts/qc_report.py"


rule qc_registration:
    input:
        reg_done=f"{PROJECT}/data/processed/registered/.snakemake_complete",
    output:
        sentinel=f"{PROJECT}/qc_plots/.snakemake_complete_registration",
    params:
        stage="registration",
        project_dir=PROJECT,
        kintsugi_dir=KINTSUGI,
        cycles=CYCLES,
        channels=CHANNELS,
        n_zplanes=N_ZPLANES,
        channel_names=CHANNEL_NAMES,
    resources:
        mem_mb=RES.get("mem_qc_registration", 16000),
        runtime=RES.get("time_qc_registration", 30),
        slurm_partition=_QC_CPU_ASSIGN["partition"],
        slurm_account=_QC_CPU_ASSIGN["account"],
        gres="",
        cpus_per_task=2,
    log:
        f"{PROJECT}/slurm/logs/snakemake/qc_registration.log",
    script:
        "scripts/qc_report.py"


# ===========================================================================
# Rule: Cleanup Safety Gate
# ===========================================================================
# Produces a .cleanup_safe sentinel ONLY when ALL declared consumers of
# intermediate data are complete (including optional stages like vessel3d
# if configured in optional_stages). This integrates with the DAG —
# Snakemake won't mark it done until ALL dependencies are met.
#
# Invoke explicitly:
#   snakemake cleanup_safe --profile profiles/slurm
#   kintsugi workflow cleanup execute .   # (preferred — uses Python safety module)

OPTIONAL_CFG = config.get("optional_stages", {})


def _cleanup_safe_inputs():
    """Build list of ALL sentinel files that must exist before cleanup is safe."""
    inputs = {}

    # QC sentinels (stitch, decon, edf — registration NOT required)
    inputs["qc_stitch"] = f"{PROJECT}/qc_plots/.snakemake_complete_stitch"
    inputs["qc_decon"] = f"{PROJECT}/qc_plots/.snakemake_complete_decon"
    inputs["qc_edf"] = f"{PROJECT}/qc_plots/.snakemake_complete_edf"

    # All EDF sentinels (primary consumer of deconvolved data)
    for c in CYCLES:
        inputs[f"edf_cyc{cyc_fmt(c)}"] = (
            f"{PROJECT}/data/processed/edf/cyc{cyc_fmt(c)}/.snakemake_complete"
        )

    # Signal isolation (consumer of registered data)
    inputs["signal_isolation"] = (
        f"{PROJECT}/data/processed/signal_isolated/.snakemake_complete"
    )

    # Optional: vessel3d sentinels (second consumer of deconvolved data)
    v3d_cfg = OPTIONAL_CFG.get("vessel3d", {})
    if isinstance(v3d_cfg, dict) and v3d_cfg.get("enabled", False):
        v3d_cycles = v3d_cfg.get("cycles", [])
        if v3d_cycles:
            for c in v3d_cycles:
                inputs[f"vessel3d_cyc{cyc_fmt(c)}"] = (
                    f"{PROJECT}/data/processed/vessel_3d/cyc{cyc_fmt(c)}/.snakemake_complete"
                )
        else:
            # Empty list = all cycles
            for c in CYCLES:
                inputs[f"vessel3d_cyc{cyc_fmt(c)}"] = (
                    f"{PROJECT}/data/processed/vessel_3d/cyc{cyc_fmt(c)}/.snakemake_complete"
                )

    return inputs


rule cleanup_safe:
    """Sentinel: all consumers of intermediate data are complete.

    Use `kintsugi workflow cleanup execute .` (preferred) or target this
    rule to verify cleanup safety via Snakemake's DAG:
        snakemake cleanup_safe --profile profiles/slurm
    """
    input:
        **_cleanup_safe_inputs(),
    output:
        sentinel=f"{PROJECT}/data/processed/.cleanup_safe",
    run:
        with open(output.sentinel, "w") as f:
            import datetime
            f.write(f"cleanup_safe {datetime.datetime.now().isoformat()}\n")
            f.write(f"inputs: {len(input)}\n")
            for k, v in dict(input).items():
                f.write(f"  {k}: {v}\n")
