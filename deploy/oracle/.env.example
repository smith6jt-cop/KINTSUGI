# Copy to .env (never commit .env) and fill in.

# Shared secret: Bearer token for Claude Code and the passphrase typed on the
# /login page for claude.ai. Generate with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
KINTSUGI_MCP_TOKEN=

# Public DNS name pointing at the VM's public IP (e.g. a free DuckDNS name).
PUBLIC_HOST=kintsugi-demo.duckdns.org

# Optional: e-mail for Let's Encrypt expiry notices.
ACME_EMAIL=

# Absolute path on the VM of the KINTSUGI project to serve (contains
# kintsugi_project.json). Must be writable by uid 1000.
PROJECT_DIR=/srv/kintsugi/HBM283_LN

# Memory limit of the MCP container (Always Free A1: 12 GB total).
KINTSUGI_MEM_LIMIT=9g
